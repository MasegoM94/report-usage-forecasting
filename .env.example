# Environment variable template — copy this file to .env and fill in your values.
# .env is gitignored and must never be committed.
# .env.example is safe to commit; it contains no real credentials.

# OpenAI API key — required only for live LLM-generated insights.
# If absent, the GenAI pipeline falls back to deterministic rule-based summaries
# and the Streamlit app displays stored outputs unchanged.
# All 3 580 tests pass without this key set.
OPENAI_API_KEY=
